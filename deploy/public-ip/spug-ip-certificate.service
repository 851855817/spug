[Unit]
Description=Renew the Spug public IP HTTPS certificate
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/opt/spug/public-access/certbot-venv/bin/certbot renew --cert-name spug-public-ip --non-interactive --quiet --no-random-sleep-on-renew
TimeoutStartSec=300
PrivateTmp=true
NoNewPrivileges=true
